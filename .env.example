# Local dev
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/qr_attendance
SECRET_KEY=CHANGE_ME_TO_A_LONG_RANDOM_STRING
APP_BASE_URL=http://127.0.0.1:8000

# Security / Behavior
JWT_EXPIRE_MIN=10080
DYNAMIC_KEY_TTL_SEC=20
LATE_AFTER_MIN=10
COOKIE_SECURE=0
COOKIE_SAMESITE=lax

# Optional: auto-run migrations on startup (useful for Render first deploy)
MIGRATE_ON_START=0

# Timezone display (DB stays UTC)
TZ=Europe/Istanbul
